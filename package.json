{
  "name": "tasker",
  "version": "2.0.0",
  "description": "A Todoist-style terminal task manager built with OpenTUI and React",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build --compile src/index.tsx --outfile tasker --external @opentui/core-darwin-x64 --external @opentui/core-darwin-arm64 --external @opentui/core-linux-arm64 --external @opentui/core-win32-x64 --external @opentui/core-win32-arm64 --external @opentui/core-linux-x64-musl --external @opentui/core-linux-arm64-musl",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.7.0",
    "@opentui/react": "0.7.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
